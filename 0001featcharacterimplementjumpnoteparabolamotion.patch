@@ -135,8 +135,8 @@ func find_editor_connector(keyframe: Keyframe):
 		pass
 
 func _on_jump_character(judgement: int, note: Note, is_long_end: bool, fastslow: Note.Fastslow):
-	character.jumping = true
-	character.jumping_note = note
+	if character != null:

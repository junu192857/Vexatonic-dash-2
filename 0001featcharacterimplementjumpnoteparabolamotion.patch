@@ -307,6 +307,8 @@ func assign_note(note: Note):
 	note.judgement_spread.connect($IngameDataManager.catch_judgement)
 	if (note.get_data().type == 2):
 		note.judgement_spread.connect(lane._on_jump_character)
+		if lane.character != null:
+			lane.character.add_pending_jump(note)
 
 #============================== End Level ==================================
 
diff --git a/vexatonic-dash-2/Scripts/Lane/Lane.gd b/vexatonic-dash-2/Scripts/Lane/Lane.gd
